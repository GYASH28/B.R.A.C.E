{
  "name": "brace-interface",
  "private": true,
  "version": "1.0.0",
  "productName": "B.R.A.C.E",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "node --test backend/**/*.test.cjs",
    "build": "tsc && vite build",
    "desktop": "npm run build && npm run launch",
    "dist:win": "npm run build && electron-builder --win portable --x64",
    "preview": "vite preview",
    "launch": "electron .",
    "dist:linux": "npm run build && electron-builder --linux AppImage --x64",
    "smoke:codex": "node scripts/smoke-codex.cjs",
    "verify:local": "bash scripts/verify-brace-local.sh"
  },
  "build": {
    "appId": "local.brace.assistant",
    "productName": "B.R.A.C.E",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "backend/**/*",
      "package.json",
      "scripts/voice/**/*"
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "B.R.A.C.E-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "B.R.A.C.E-${version}-${arch}.${ext}"
    },
    "asar": true,
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "B.R.A.C.E-${version}-${arch}.${ext}",
      "category": "Utility"
    },
    "asarUnpack": [
      "scripts/voice/**/*"
    ]
  },
  "devDependencies": {
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "electron": "^42.2.0",
    "electron-builder": "^26.8.1",
    "playwright": "^1.60.0",
    "typescript": "~6.0.2",
    "vite": "^8.0.12"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@vitejs/plugin-react": "^6.0.2",
    "framer-motion": "^12.40.0",
    "lucide-react": "^1.16.0",
    "mammoth": "^1.12.0",
    "pdf-parse": "^2.4.5",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "systeminformation": "^5.31.6",
    "tailwindcss": "^4.3.0"
  },
  "engines": {
    "node": ">=22.6.0"
  }
}
