# B.R.A.C.E. Core
APP_NAME=B.R.A.C.E.
APP_FULL_FORM=Brain-like Responsive Assistant for Creation and Execution
APP_ENV=development
APP_VERSION=1.0.0

# Safety
SAFE_MODE=true
ALLOW_SYSTEM_COMMANDS=false
ALLOW_FILE_DELETE=false
ALLOW_EXTERNAL_MESSAGE_SEND=false
ALLOW_BROWSER_AUTOMATION=false

# Gemini Live / Chat
GEMINI_API_KEY=your_gemini_api_key_here
BRACE_LIVE_MODEL=models/gemini-2.5-flash-native-audio-preview-12-2025
BRACE_TEXT_MODEL=gemini-2.5-flash
BRACE_VOICE_NAME=Charon
BRACE_RESPONSE_STYLE=clear, confident, helpful
BRACE_VOICE_ENABLED=true
BRACE_ASSISTANT_NAME=B.R.A.C.E.
BRACE_MUSIC_DIR=~/Music
BRACE_NOTES_DIR=./outputs/notes
BRACE_LEGACY_VOICE_ENABLED=false
BRACE_LEGACY_STT_ENABLED=false

# OpenClaw
OPENCLAW_ENABLED=false
OPENCLAW_GATEWAY_URL=http://127.0.0.1:18789
OPENCLAW_PORT=18789
OPENCLAW_SAFE_MODE=true

# MCP
MCP_ENABLED=false
MCP_CONFIG_PATH=./config/mcp_servers.json

# Nano Banana / Gemini Image API
NANO_BANANA_MCP_ENABLED=false
NANO_BANANA_MCP_PACKAGE=nano-banana-mcp
NANO_BANANA_OUTPUT_DIR=./outputs/images
NANOBANANA_MODEL=gemini-2.0-flash-exp

# NVIDIA NIM / Build APIs
NVIDIA_ENABLED=false
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_DEFAULT_MODEL=paste_model_id_from_build_nvidia_com

# Optional Providers
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GROQ_API_KEY=your_groq_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Local AI
LOCAL_AI_ENABLED=false
LOCAL_AI_BASE_URL=http://localhost:11434/v1
LOCAL_AI_DEFAULT_MODEL=local-model-name

# App Paths
LOG_DIR=./logs
OUTPUT_DIR=./outputs
MEMORY_DIR=./memory
